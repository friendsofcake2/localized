{
    "name": "friendsofcake2/localized",
    "description": "CakePHP 2 Localized Plugin",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "localized", "i18n", "l10n"],
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "composer/installers": "*",
        "friendsofcake2/cakephp": "^2.10"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.0",
        "friendsofcake2/phpstan-cakephp2": "^0.2.1",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6"
    },
    "replace": {
        "cakephp/localized": "^2.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "Localized"
    }
}
